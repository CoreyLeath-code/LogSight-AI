# LogSight-AI Environment Variables
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit secrets.

# ── Anomaly Detection ─────────────────────────────────────────────────────────
# Z-score threshold for anomaly detection (default: 2.5)
LOGSIGHT_THRESHOLD=2.5

# Sliding-window size for error-rate spike detection (default: 100)
LOGSIGHT_WINDOW=100

# Error-rate fraction that constitutes a spike (default: 0.25)
LOGSIGHT_SPIKE_THRESHOLD=0.25

# ── Optional Integrations ─────────────────────────────────────────────────────
# Uncomment and set if you connect an external service in future.

# Log file path used as default when running in container
# LOGSIGHT_LOG_FILE=/var/log/app.log

# ── Optional FastAPI bearer-token guard (development default: disabled) ──────
# Set mode=token for a guarded API; keep the token in a managed secret store.
# This is one shared key, NOT tenant-scoped authorization or a production identity provider.
# LOGSIGHT_API_AUTH_MODE=token
# LOGSIGHT_API_TOKEN=<at-least-32-random-characters>

# Optional experimental broker-acknowledged API ingestion (disabled by default)
# Requires .[api,kafka], managed broker credentials/TLS, and no Redis admission
# LOGSIGHT_API_KAFKA_ENABLED=true
# KAFKA_BOOTSTRAP_SERVERS=broker:9092
# LOGSIGHT_KAFKA_TOPIC=logsight-events

# Experimental standalone Kafka -> ClickHouse worker (not production-hardened)
# Requires installation: python -m pip install -e ".[kafka]"
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# LOGSIGHT_KAFKA_TOPIC=logsight-events
# LOGSIGHT_KAFKA_CONSUMER_GROUP=logsight-clickhouse-v1
# CLICKHOUSE_URL=http://localhost:8123

# Optional FastAPI ingestion body-size limit in bytes (default: 1048576 = 1 MiB)
# LOGSIGHT_API_MAX_BODY_BYTES=1048576
